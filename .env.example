# Copy this file to .env. Change only these values to switch LLM providers.
# Never commit .env or an API key.

# Active provider: openai | gemini | openrouter | groq
LLM_PROVIDER=gemini

# The exact model identifier offered by the selected provider.
LLM_MODEL=gemini-2.5-flash

# Key for the selected provider. This is intentionally one provider-neutral name.
LLM_API_KEY=

# Required for OpenRouter and Groq; optional for OpenAI and Gemini.
# OpenRouter: https://openrouter.ai/api/v1
# Groq:       https://api.groq.com/openai/v1
LLM_BASE_URL=

# Set to 1 to avoid the one-request connection check before a curriculum run.
LLM_SKIP_TEST=0

# Provider examples (uncomment/copy one complete block into the settings above):
#
# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_key
# LLM_BASE_URL=
#
# Google Gemini (native google-genai SDK)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your_gemini_key
# LLM_BASE_URL=
#
# OpenRouter (OpenAI-compatible API)
# LLM_PROVIDER=openrouter
# LLM_MODEL=provider/model-name
# LLM_API_KEY=your_openrouter_key
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Groq (OpenAI-compatible API)
# LLM_PROVIDER=groq
# LLM_MODEL=provider-model-name
# LLM_API_KEY=your_groq_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
#
# Visual mode: seconds between each rendered action (default 0.55).
# Lower = faster, higher = slower. 0.5-0.6 is recommended for live demos.
HOMEGRID_RENDER_DELAY=0.55

# Legacy OPENAI_API_KEY and OPENAI_MODEL are accepted only as migration
# fallbacks. New configurations should use the LLM_* variables above.
